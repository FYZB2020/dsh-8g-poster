{
  "name": "dsh-8g-poster",
  "version": "1.0.1",
  "description": "Poster8G · 8G 海报 —— a poster workshop for DeepSeek Harness that runs on your own 8 GB GPU: local AI backgrounds, cut-out assembly, QR verification, an editable workbench, and print-ready output. 本地生图 + 素材合成 + 二维码防错校验 + 可编辑工作台 + 印刷件输出，零按张付费。",
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "dsh",
    "deepseek-harness",
    "mcp",
    "poster",
    "poster-maker",
    "design",
    "layout",
    "qr",
    "comfyui",
    "flux",
    "moss-image",
    "local-ai",
    "8gb-vram",
    "print",
    "low-vram",
    "8g-poster",
    "no-subscription",
    "print-ready"
  ],
  "license": "MIT",
  "author": {
    "name": "FYZB2020",
    "url": "https://github.com/FYZB2020"
  },
  "homepage": "https://github.com/FYZB2020/dsh-8g-poster#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FYZB2020/dsh-8g-poster.git"
  },
  "bugs": {
    "url": "https://github.com/FYZB2020/dsh-8g-poster/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "poster8g-mcp": "server/index.js"
  },
  "files": [
    "lib",
    "server",
    "test",
    "assets",
    "python",
    "skill",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "mcpServers": {
      "poster8g": {
        "command": "node",
        "args": [
          "server/index.js"
        ],
        "env": {
          "POSTER_PYTHON": "python"
        }
      }
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/route.mjs && node test/ver.mjs && node test/tools.mjs",
    "smoke": "node test/smoke.mjs",
    "mcp": "node server/index.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  }
}
